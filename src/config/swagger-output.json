{
  "openapi": "3.0.0",
  "info": {
    "title": "API - Veterinaria",
    "description": "Documentacion del sistema de Veterinaria",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registrar un usuario nuevo",
        "description": "registra a un usuario nuevo en el sistema",
        "responses": {
          "201": {
            "description": "Created"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/registerDTO"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/registerDTO"
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Inicio de Sesion",
        "description": "Autentica a un usuario y retorna su JWT",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/loginDTO"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/loginDTO"
              }
            }
          }
        }
      }
    },
    "/usuarios/": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "ver a todos los usuarios",
        "description": "Permite visualizar el listado de todos los usuarios",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "description": "",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "example": "any"
                  },
                  "email": {
                    "example": "any"
                  },
                  "password": {
                    "example": "any"
                  },
                  "rol": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dueños/": {
      "post": {
        "tags": [
          "Dueños"
        ],
        "description": "Registra un nuevo dueño (solo recepción)",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "example": "any"
                  },
                  "telefono": {
                    "example": "any"
                  },
                  "email": {
                    "example": "any"
                  },
                  "direccion": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dueños/{id}": {
      "get": {
        "tags": [
          "Dueños"
        ],
        "description": "Devuelve un dueño con sus mascotas",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Rol": {
        "example": "RECEPCIONISTA",
        "type": "string",
        "enum": [
          "RECEPCIONISTA",
          "VETERINARIO",
          "LABORATORISTA"
        ],
        "xml": {
          "name": "Rol"
        }
      },
      "Especie": {
        "type": "string",
        "enum": [
          "PERRO",
          "GATO"
        ],
        "xml": {
          "name": "Especie"
        }
      },
      "EstadoAtencion": {
        "type": "string",
        "enum": [
          "EN_CONSULTA",
          "EN_ESPERA_EXAMENES",
          "DADA_DE_ALTA"
        ],
        "xml": {
          "name": "EstadoAtencion"
        }
      },
      "TipoExamen": {
        "type": "string",
        "enum": [
          "HEMOGRAMA",
          "RAYOS_X",
          "ECOGRAFICA"
        ],
        "xml": {
          "name": "TipoExamen"
        }
      },
      "EstadoExamen": {
        "type": "string",
        "enum": [
          "PENDIENTE",
          "CANCELADO",
          "COMPLETADO"
        ],
        "xml": {
          "name": "EstadoExamen"
        }
      },
      "loginDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "veterinario@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "123456789"
          }
        },
        "xml": {
          "name": "loginDTO"
        }
      },
      "registerDTO": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "juan perez"
          },
          "email": {
            "type": "string",
            "example": "veterinario@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "123456789"
          },
          "rol": {
            "type": "string",
            "example": "VETERNIARIO"
          }
        },
        "xml": {
          "name": "registerDTO"
        }
      }
    }
  }
}