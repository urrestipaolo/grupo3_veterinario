  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Rol": {
        "example": "RECEPCIONISTA",
        "type": "string",
        "enum": [
          "RECEPCIONISTA",
          "VETERINARIO",
          "LABORATORISTA"
        ],
        "xml": {
          "name": "Rol"
        }
      },
      "Especie": {
        "type": "string",
        "enum": [
          "PERRO",
          "GATO"
        ],
        "xml": {
          "name": "Especie"
        }
      },
      "EstadoAtencion": {
        "type": "string",
        "enum": [
          "EN_CONSULTA",
          "EN_ESPERA_EXAMENES",
          "DADA_DE_ALTA"
        ],
        "xml": {
          "name": "EstadoAtencion"
        }
      },
      "TipoExamen": {
        "type": "string",
        "enum": [
          "HEMOGRAMA",
          "RAYOS_X",
          "ECOGRAFICA"
        ],
        "xml": {
          "name": "TipoExamen"
        }
      },
      "EstadoExamen": {
        "type": "string",
        "enum": [
          "PENDIENTE",
          "CANCELADO",
          "COMPLETADO"
        ],
        "xml": {
          "name": "EstadoExamen"
        }
      },
      "loginDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "veterinario@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "123456789"
          }
        },
        "xml": {
          "name": "loginDTO"
        }
      },
      "registerDTO": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "juan perez"
          },
          "email": {
            "type": "string",
            "example": "veterinario@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "123456789"
          },
          "rol": {
